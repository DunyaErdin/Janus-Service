# ── App ──────────────────────────────────────────────────────────────────────
EDGE_AI_APP_NAME=Janus Edge AI
EDGE_AI_ENVIRONMENT=development
EDGE_AI_LOG_LEVEL=INFO
EDGE_AI_LOG_JSON=true
EDGE_AI_SERVER_HOST=0.0.0.0
EDGE_AI_SERVER_PORT=8080
EDGE_AI_PROXY_HEADERS=true
EDGE_AI_FORWARDED_ALLOW_IPS=*
EDGE_AI_ROBOT_NAME=Janus
EDGE_AI_DEFAULT_LANGUAGE=tr-TR

# ── WebSocket ─────────────────────────────────────────────────────────────────
EDGE_AI_WEBSOCKET_PATH=/ws/device
EDGE_AI_ALLOWED_DEVICE_IDS=
EDGE_AI_DEVICE_AUTH_TOKEN=
EDGE_AI_DEBUG_AUDIO_TOKEN=

# ── Provider selection ────────────────────────────────────────────────────────
EDGE_AI_LLM_PROVIDER=claude
EDGE_AI_STT_PROVIDER=mock
EDGE_AI_TTS_PROVIDER=openrouter
EDGE_AI_WAKE_DETECTOR_PROVIDER=dev_fake

# ── Claude (LLM / text generation only) ──────────────────────────────────────
EDGE_AI_ANTHROPIC_API_KEY=
EDGE_AI_CLAUDE_MODEL_ID=claude-haiku-4-5-20251001
EDGE_AI_CLAUDE_MAX_TOKENS=600

# ── OpenRouter TTS ────────────────────────────────────────────────────────────
EDGE_AI_OPENROUTER_API_KEY=
EDGE_AI_OPENROUTER_TTS_BASE_URL=https://openrouter.ai/api/v1
EDGE_AI_OPENROUTER_TTS_MODEL=openai/gpt-4o-mini-tts-2025-12-15
EDGE_AI_OPENROUTER_TTS_VOICE=coral
EDGE_AI_OPENROUTER_TTS_RESPONSE_FORMAT=pcm
EDGE_AI_OPENROUTER_TTS_SPEED=1.0
EDGE_AI_OPENROUTER_HTTP_REFERER=
EDGE_AI_OPENROUTER_APP_TITLE=Janus Edge AI

# ── TTS cache ─────────────────────────────────────────────────────────────────
EDGE_AI_TTS_CACHE_FIRST=true
EDGE_AI_TTS_CACHE_DIR=data/tts_cache

# ── Gemini (disabled — do not use) ───────────────────────────────────────────
EDGE_AI_GEMINI_ENABLED=false
EDGE_AI_GEMINI_API_KEY=
EDGE_AI_GEMINI_MODEL_ID=
EDGE_AI_GEMINI_STT_MODEL_ID=
EDGE_AI_GEMINI_TTS_MODEL_ID=
EDGE_AI_GEMINI_TTS_VOICE_NAME=

# ── Native OpenAI (disabled — use OpenRouter instead) ────────────────────────
EDGE_AI_OPENAI_ENABLED=false
EDGE_AI_OPENAI_API_KEY=
EDGE_AI_OPENAI_TTS_MODEL=
EDGE_AI_OPENAI_TTS_VOICE=

# ── Session / audio limits ────────────────────────────────────────────────────
EDGE_AI_REQUEST_TIMEOUT_SECONDS=15.0
EDGE_AI_MAX_AUDIO_CHUNKS_PER_SESSION=256
EDGE_AI_MAX_WAKE_CHUNKS_PER_INTERACTION=24
EDGE_AI_MAX_WAKE_BASE64_CHARS_PER_INTERACTION=65536
EDGE_AI_DEBUG_STORE_RAW_WAKE_AUDIO=false
EDGE_AI_SESSION_HISTORY_LIMIT=20
EDGE_AI_WEBSOCKET_HELLO_TIMEOUT_SECONDS=10.0
EDGE_AI_WEBSOCKET_RECEIVE_TIMEOUT_SECONDS=90.0
EDGE_AI_WEBSOCKET_CLOSE_TIMEOUT_SECONDS=2.0
EDGE_AI_WEBSOCKET_MAX_PROTOCOL_ERRORS=3
EDGE_AI_WEBSOCKET_MAX_MESSAGE_BYTES=1048576
EDGE_AI_WEBSOCKET_PING_INTERVAL_SECONDS=20.0
EDGE_AI_WEBSOCKET_PING_TIMEOUT_SECONDS=20.0
